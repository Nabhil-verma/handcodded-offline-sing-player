<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Offline Music Player</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #101117;
      --panel: #191b25;
      --panel2: #222431;
      --text: #f5f5f7;
      --muted: #a4a6b5;
      --accent: #b7f36b;
      --line: #303240;
      --danger: #ff7777;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(ellipse at top left, #222638, var(--bg) 55%);
      color: var(--text);
      font: 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    button, input { font: inherit; }
    button {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 10px 14px;
      color: var(--text);
      background: var(--panel2);
      cursor: pointer;
      transition: .15s ease;
    }
    button:hover { border-color: #686b7d; transform: translateY(-1px); }
    button:disabled { opacity: .4; cursor: default; transform: none; }
    .accent { color: #141810; background: var(--accent); border-color: var(--accent); font-weight: 700; }
    .small { padding: 7px 10px; }
    .icon { width: 42px; height: 42px; padding: 0; font-size: 17px; }
    header, main { width: min(1100px, calc(100% - 32px)); margin: auto; }
    header { padding: 34px 0 20px; }
    h1 { margin: 0; font-size: clamp(26px, 4vw, 38px); letter-spacing: -.04em; }
    .subtitle { color: var(--muted); margin: 6px 0 0; }
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 310px; gap: 18px; padding-bottom: 30px; }
    .panel { background: color-mix(in srgb, var(--panel) 94%, transparent); border: 1px solid var(--line); border-radius: 18px; padding: 18px; }
    .toolbar { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; }
    .toolbar .spacer { flex: 1; }
    #search {
      width: 100%; margin-top: 14px; padding: 12px 14px; border-radius: 12px;
      border: 1px solid var(--line); background: #11131a; color: var(--text); outline: none;
    }
    #search:focus { border-color: var(--accent); }
    .dropzone {
      margin-top: 14px; padding: 13px; border: 1px dashed #55596b; border-radius: 12px;
      text-align: center; color: var(--muted);
    }
    .dropzone.over { border-color: var(--accent); color: var(--accent); background: #b7f36b12; }
    .list-head { display: flex; align-items: center; justify-content: space-between; margin: 19px 2px 8px; color: var(--muted); font-size: 13px; }
    #list { list-style: none; padding: 0; margin: 0; max-height: 55vh; overflow: auto; }
    .track {
      display: grid; grid-template-columns: 38px minmax(0,1fr) auto; gap: 11px; align-items: center;
      padding: 10px; border-radius: 12px; cursor: pointer;
    }
    .track:hover { background: #ffffff0a; }
    .track.active { background: #b7f36b18; }
    .track-number { color: var(--muted); text-align: center; font-variant-numeric: tabular-nums; }
    .track-title { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 600; }
    .track-meta { color: var(--muted); font-size: 12px; }
    .track-actions { display: flex; gap: 6px; align-items: center; }
    .remove { border: 0; background: transparent; color: var(--muted); padding: 6px 8px; }
    .remove:hover { color: var(--danger); transform: none; }
    .now { text-align: center; padding: 20px 10px 14px; }
    .art {
      width: 190px; height: 190px; margin: 0 auto 20px; border-radius: 26px;
      display: grid; place-items: center; font-size: 76px;
      background: linear-gradient(140deg, #30364a, #1a1b25 60%, #37462a);
      box-shadow: 0 18px 45px #0006;
    }
    #nowTitle { font-size: 19px; font-weight: 700; overflow-wrap: anywhere; }
    #nowMeta { color: var(--muted); margin-top: 4px; font-size: 13px; }
    .timeline { display: grid; grid-template-columns: 42px 1fr 42px; gap: 9px; align-items: center; margin: 18px 0; }
    .time { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
    input[type="range"] { width: 100%; accent-color: var(--accent); }
    .controls { display: flex; justify-content: center; gap: 10px; align-items: center; }
    #play { width: 56px; height: 56px; font-size: 21px; border-radius: 50%; }
    .options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 22px; }
    .option { color: var(--muted); font-size: 12px; }
    .option button { margin-top: 6px; width: 100%; }
    .volume { margin-top: 18px; }
    .hint { margin-top: 16px; color: var(--muted); font-size: 12px; }
    .empty { padding: 28px 12px; text-align: center; color: var(--muted); }
    .toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: #282b38; border: 1px solid var(--line); border-radius: 12px; padding: 10px 15px; display: none; }
    @media (max-width: 760px) {
      .layout { grid-template-columns: 1fr; }
      #list { max-height: 42vh; }
      .player { grid-row: 1; }
      .art { width: 150px; height: 150px; font-size: 60px; }
    }
  </style>
</head>
<body>
  <header>
    <h1>Offline Music Player</h1>
    <p class="subtitle">Your music, on your device. No account or internet required.</p>
  </header>

  <main class="layout">
    <section class="panel">
      <div class="toolbar">
        <button class="accent" id="addBtn">＋ Add songs</button>
        <button id="folderBtn">＋ Add folder</button>
        <span class="spacer"></span>
        <button class="small" id="clearBtn">Clear library</button>
        <input id="files" type="file" accept="audio/*,.mp3,.m4a,.aac,.wav,.ogg,.flac,.opus,.aiff" multiple hidden>
        <input id="folder" type="file" accept="audio/*" webkitdirectory multiple hidden>
      </div>
      <input id="search" type="search" placeholder="Search your library…" aria-label="Search your library">
      <div class="dropzone" id="dropzone">Or drag and drop audio files here</div>
      <div class="list-head"><span>Your library</span><span id="count">0 songs</span></div>
      <ul id="list"></ul>
    </section>

    <aside class="panel player">
      <div class="now">
        <div class="art">♫</div>
        <div id="nowTitle">Choose a song</div>
        <div id="nowMeta">Your offline library</div>
      </div>
      <audio id="audio" preload="metadata"></audio>
      <div class="timeline">
        <span class="time" id="elapsed">0:00</span>
        <input id="seek" type="range" min="0" max="1000" value="0" aria-label="Seek">
        <span class="time" id="duration">0:00</span>
      </div>
      <div class="controls">
        <button class="icon" id="shuffle" title="Shuffle">🔀</button>
        <button class="icon" id="prev" title="Previous">⏮</button>
        <button class="icon accent" id="play" title="Play / pause">▶</button>
        <button class="icon" id="next" title="Next">⏭</button>
        <button class="icon" id="repeat" title="Repeat mode">↻</button>
      </div>
      <div class="options">
        <div class="option">Playback speed
          <button id="speed">1×</button>
        </div>
        <div class="option">Skip by
          <button id="skip">15 sec</button>
        </div>
      </div>
      <div class="option volume">Volume
        <input id="volume" type="range" min="0" max="1" step="0.01" value="0.85" aria-label="Volume">
      </div>
      <div class="hint">Shortcuts: Space play/pause · ←/→ seek · ↑/↓ volume · N next · P previous</div>
    </aside>
  </main>
  <div class="toast" id="toast" role="status"></div>

<script>
(() => {
  const $ = id => document.getElementById(id);
  const audio = $("audio");
  let db, tracks = [], currentId = null, objectUrl = null;
  let shuffleOn = false, repeatMode = 0, speedIndex = 0, skipIndex = 0;
  const speeds = [1, 1.25, 1.5, 1.75, 2, 0.75];
  const skips = [15, 30, 5, 10, 60];
  const repeatLabels = ["↻", "↻¹", "↻"];
  const repeatTitles = ["Repeat off", "Repeat one", "Repeat all"];

  function toast(message) {
    const el = $("toast");
    el.textContent = message;
    el.style.display = "block";
    clearTimeout(toast.timer);
    toast.timer = setTimeout(() => el.style.display = "none", 2600);
  }
  function formatTime(seconds) {
    if (!Number.isFinite(seconds)) return "0:00";
    const n = Math.floor(seconds);
    return Math.floor(n / 60) + ":" + String(n % 60).padStart(2, "0");
  }
  function openDB() {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open("OfflineMusicPlayer", 1);
      request.onupgradeneeded = () => request.result.createObjectStore("tracks", { keyPath: "id" });
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
  }
  function store(mode, action) {
    return new Promise((resolve, reject) => {
      const tx = db.transaction("tracks", mode);
      const req = action(tx.objectStore("tracks"));
      tx.oncomplete = () => resolve(req && req.result);
      tx.onerror = () => reject(tx.error);
      tx.onabort = () => reject(tx.error);
    });
  }
  function safeId() {
    return (crypto.randomUUID ? crypto.randomUUID() : Date.now() + "-" + Math.random().toString(16).slice(2));
  }
  function render() {
    const query = $("search").value.trim().toLowerCase();
    const filtered = tracks.filter(t => t.name.toLowerCase().includes(query));
    $("count").textContent = `${tracks.length} ${tracks.length === 1 ? "song" : "songs"}`;
    const list = $("list");
    list.replaceChildren();
    if (!filtered.length) {
      const li = document.createElement("li");
      li.className = "empty";
      li.textContent = tracks.length ? "No matching songs." : "Your library is empty. Add some downloaded songs to get started.";
      list.append(li);
      return;
    }
    filtered.forEach((track, i) => {
      const li = document.createElement("li");
      li.className = "track" + (track.id === currentId ? " active" : "");
      const num = document.createElement("span");
      num.className = "track-number";
      num.textContent = track.id === currentId && !audio.paused ? "♫" : String(i + 1).padStart(2, "0");
      const info = document.createElement("div");
      const title = document.createElement("div");
      title.className = "track-title";
      title.textContent = track.name;
      const meta = document.createElement("div");
      meta.className = "track-meta";
      meta.textContent = [track.duration ? formatTime(track.duration) : "", track.size ? (track.size / 1048576).toFixed(1) + " MB" : ""].filter(Boolean).join(" · ");
      info.append(title, meta);
      const actions = document.createElement("div");
      actions.className = "track-actions";
      const remove = document.createElement("button");
      remove.className = "remove";
      remove.title = "Remove song";
      remove.setAttribute("aria-label", "Remove " + track.name);
      remove.textContent = "✕";
      remove.addEventListener("click", e => { e.stopPropagation(); removeTrack(track.id); });
      actions.append(remove);
      li.append(num, info, actions);
      li.addEventListener("click", () => playTrack(track.id));
      list.append(li);
    });
  }
  async function addFiles(fileList) {
    const files = Array.from(fileList).filter(f => f.type.startsWith("audio/") || /\.(mp3|m4a|aac|wav|ogg|flac|opus|aiff)$/i.test(f.name));
    if (!files.length) { toast("No supported audio files found."); return; }
    let added = 0;
    for (const file of files) {
      const duplicate = tracks.some(t => t.name === file.name && t.size === file.size && t.lastModified === file.lastModified);
      if (duplicate) continue;
      const track = { id: safeId(), name: file.name, size: file.size, type: file.type, lastModified: file.lastModified, blob: file, duration: 0 };
      try {
        await store("readwrite", s => s.put(track));
        tracks.push(track);
        added++;
      } catch (e) {
        console.error(e);
        toast("Could not save this song. Browser storage may be full.");
        break;
      }
    }
    render();
    toast(added ? `Added ${added} ${added === 1 ? "song" : "songs"}.` : "Those songs are already in your library.");
  }
  async function playTrack(id) {
    const track = tracks.find(t => t.id === id);
    if (!track) return;
    try {
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(track.blob);
      currentId = id;
      audio.src = objectUrl;
      $("nowTitle").textContent = track.name;
      $("nowMeta").textContent = "From your offline library";
      render();
      await audio.play();
    } catch (e) {
      console.error(e);
      toast("This file could not be played by your browser.");
    }
  }
  function nextTrack() {
    if (!tracks.length) return;
    if (shuffleOn && tracks.length > 1) {
      const choices = tracks.filter(t => t.id !== currentId);
      playTrack(choices[Math.floor(Math.random() * choices.length)].id);
      return;
    }
    const index = tracks.findIndex(t => t.id === currentId);
    playTrack(tracks[(index + 1 + tracks.length) % tracks.length].id);
  }
  function previousTrack() {
    if (!tracks.length) return;
    if (audio.currentTime > 3) { audio.currentTime = 0; return; }
    const index = tracks.findIndex(t => t.id === currentId);
    playTrack(tracks[(index - 1 + tracks.length) % tracks.length].id);
  }
  async function removeTrack(id) {
    const index = tracks.findIndex(t => t.id === id);
    if (index < 0) return;
    await store("readwrite", s => s.delete(id));
    tracks.splice(index, 1);
    if (currentId === id) {
      audio.pause();
      audio.removeAttribute("src");
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = currentId = null;
      $("nowTitle").textContent = "Choose a song";
      $("nowMeta").textContent = "Your offline library";
      $("play").textContent = "▶";
      $("elapsed").textContent = $("duration").textContent = "0:00";
      $("seek").value = 0;
    }
    render();
  }

  $("addBtn").onclick = () => $("files").click();
  $("folderBtn").onclick = () => $("folder").click();
  $("files").onchange = e => { addFiles(e.target.files); e.target.value = ""; };
  $("folder").onchange = e => { addFiles(e.target.files); e.target.value = ""; };
  $("search").oninput = render;
  $("play").onclick = () => {
    if (!currentId && tracks.length) playTrack(tracks[0].id);
    else if (audio.paused) audio.play().catch(() => toast("Tap play to start audio."));
    else audio.pause();
  };
  $("next").onclick = nextTrack;
  $("prev").onclick = previousTrack;
  $("shuffle").onclick = () => {
    shuffleOn = !shuffleOn;
    $("shuffle").style.color = shuffleOn ? "var(--accent)" : "";
    toast(shuffleOn ? "Shuffle on" : "Shuffle off");
  };
  $("repeat").onclick = () => {
    repeatMode = (repeatMode + 1) % 3;
    $("repeat").textContent = repeatLabels[repeatMode];
    $("repeat").title = repeatTitles[repeatMode];
    $("repeat").style.color = repeatMode ? "var(--accent)" : "";
  };
  $("speed").onclick = () => {
    speedIndex = (speedIndex + 1) % speeds.length;
    audio.playbackRate = speeds[speedIndex];
    $("speed").textContent = speeds[speedIndex] + "×";
  };
  $("skip").onclick = () => {
    skipIndex = (skipIndex + 1) % skips.length;
    $("skip").textContent = skips[skipIndex] + " sec";
  };
  $("volume").oninput = e => audio.volume = Number(e.target.value);
  $("seek").oninput = () => {
    if (Number.isFinite(audio.duration)) audio.currentTime = audio.duration * Number($("seek").value) / 1000;
  };
  $("clearBtn").onclick = async () => {
    if (!tracks.length || !confirm("Remove every song from this browser's library?")) return;
    await store("readwrite", s => s.clear());
    tracks = [];
    audio.pause();
    audio.removeAttribute("src");
    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = currentId = null;
    $("nowTitle").textContent = "Choose a song";
    $("nowMeta").textContent = "Your offline library";
    $("play").textContent = "▶";
    $("elapsed").textContent = $("duration").textContent = "0:00";
    $("seek").value = 0;
    render();
  };

  audio.onplay = () => { $("play").textContent = "❚❚"; render(); };
  audio.onpause = () => { $("play").textContent = "▶"; render(); };
  audio.ontimeupdate = () => {
    $("elapsed").textContent = formatTime(audio.currentTime);
    if (Number.isFinite(audio.duration)) $("seek").value = Math.round(audio.currentTime / audio.duration * 1000);
  };
  audio.onloadedmetadata = async () => {
    $("duration").textContent = formatTime(audio.duration);
    const track = tracks.find(t => t.id === currentId);
    if (track && Number.isFinite(audio.duration)) {
      track.duration = audio.duration;
      try { await store("readwrite", s => s.put(track)); } catch {}
      render();
    }
  };
  audio.onended = () => {
    if (repeatMode === 1) { audio.currentTime = 0; audio.play(); }
    else if (repeatMode === 2 || shuffleOn || tracks.findIndex(t => t.id === currentId) < tracks.length - 1) nextTrack();
    else { audio.currentTime = 0; audio.pause(); }
  };
  audio.onerror = () => { if (currentId) toast("Playback error. This audio format may not be supported by your browser."); };

  const dz = $("dropzone");
  dz.ondragover = e => { e.preventDefault(); dz.classList.add("over"); };
  dz.ondragleave = () => dz.classList.remove("over");
  dz.ondrop = e => { e.preventDefault(); dz.classList.remove("over"); addFiles(e.dataTransfer.files); };

  document.addEventListener("keydown", e => {
    if (e.target.matches("input")) return;
    if (e.code === "Space") { e.preventDefault(); $("play").click(); }
    else if (e.key === "ArrowRight") { audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + skips[skipIndex]); }
    else if (e.key === "ArrowLeft") { audio.currentTime = Math.max(0, audio.currentTime - skips[skipIndex]); }
    else if (e.key === "ArrowUp") { e.preventDefault(); audio.volume = Math.min(1, audio.volume + .05); $("volume").value = audio.volume; }
    else if (e.key === "ArrowDown") { e.preventDefault(); audio.volume = Math.max(0, audio.volume - .05); $("volume").value = audio.volume; }
    else if (e.key.toLowerCase() === "n") nextTrack();
    else if (e.key.toLowerCase() === "p") previousTrack();
  });

  (async () => {
    try {
      db = await openDB();
      tracks = (await store("readonly", s => s.getAll())).sort((a, b) => a.name.localeCompare(b.name));
      render();
    } catch (e) {
      console.error(e);
      toast("Browser storage is unavailable. Try opening this file in another browser.");
    }
  })();
})();
</script>
</body>
</html>